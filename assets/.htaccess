# Stylesheets and scripts are linked with their modification time (asset() in includes/core/bootstrap.php), so a changed file has a new address
# and the old one may be kept for a year. Fonts and images keep their address, so they are kept for a shorter time.
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(woff2|png|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
