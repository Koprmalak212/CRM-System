# Copy to .env (git-ignored) and fill in the three secrets. Never commit .env.

# MariaDB administrator: used only by the container start-up (create the database, run migrations), never by the web app
DB_ROOT_PASSWORD=change-me-long-random

# Password of the limited ops_console_app database account the web app uses
CRM_DB_PASS=change-me-another-long-random

# Encrypts stored API secrets (AES-256-GCM). Generate with:  openssl rand -base64 32
# Keep a copy somewhere safe: without it the saved secrets can no longer be decrypted.
CRM_APP_KEY=

# Optional
# CRM_PORT=8080
# CRM_TIMEZONE=Europe/Amsterdam
# Behind your own reverse proxy: its address or network, so the rate limiter sees visitors' real addresses
# CRM_TRUSTED_PROXY=172.16.0.0/12
# CRM_ALLOW_PRIVATE_TARGETS=false

# Outgoing mail (what is saved in Settings > Email wins over these)
# SMTP_SERVER=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# EMAIL_FROM=
